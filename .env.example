# TMDB (https://www.themoviedb.org/settings/api) – "API Read Access Token" (v4 auth)
# Ohne diesen Token liefert /api/roulette Mock-Filme, die App läuft trotzdem.
TMDB_READ_TOKEN=

# Better Auth – Secret mit mind. 32 Zeichen, z. B. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Basis-URL der App (lokal http://localhost:3000, in Produktion die echte Domain)
BETTER_AUTH_URL=

# Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Deine Discord-User-ID (Discord: Einstellungen > Erweitert > Entwicklermodus an,
# dann Rechtsklick auf deinen Namen > "ID kopieren"). Jeder andere Login wird
# serverseitig abgelehnt.
ALLOWED_DISCORD_ID=

# Phase 2 (KI-Modus) – noch ohne Funktion, nur als Platzhalter vorbereitet.
AI_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
